+        proof["model"] = serde_json::Value::String(self.session.edi_settings.0.clone());
+        proof["reasoningEffort"] = serde_json::to_value(&self.session.edi_settings.1).map_err(|_| CodexErr::InvalidRequest("Edi effort proof unavailable".into()))?;
+        Ok(proof)
+    }
