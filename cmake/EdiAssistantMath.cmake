# SPDX-License-Identifier: BSD-3-Clause
# ADR-0057: the assistant's formula renderer, JKQtMathText 5.0.0 (upstream 9e9f0af8), vendored under
# third_party/jkqtmathtext and built here as static targets with edi's own compiler and Qt. Only the native
# desktop build carries the assistant, so the web build never reaches this file.
if(EMSCRIPTEN)
    return()
endif()
set(EDI_ASSISTANT_MATH_SOURCE "${PROJECT_SOURCE_DIR}/third_party/jkqtmathtext")
foreach(_required "lib/jkqtcommon/CMakeLists.txt" "lib/jkqtmathtext/CMakeLists.txt"
                  "lib/jkqtmathtext/resources/xits/OFL.txt" "LICENSE" "cmake/jkqtplotter_macros.cmake")
    if(NOT EXISTS "${EDI_ASSISTANT_MATH_SOURCE}/${_required}")
        message(FATAL_ERROR "third_party/jkqtmathtext is incomplete: ${_required} is missing")
    endif()
endforeach()
find_package(Qt6 REQUIRED GLOBAL COMPONENTS Widgets Xml)
function(edi_assistant_math_targets)
    set(PROJECT_VERSION 5.0.0)
    set(PROJECT_VERSION_MAJOR 5)
    set(QT_VERSION_MAJOR 6)
    set(BUILD_SHARED_LIBS OFF)
    set(CMAKE_AUTOMOC ON)
    set(jkqtplotter_LIBNAME_VERSION_PART Edi)
    set(jkqtplotter_namespace EdiMath::)
    set(JKQtPlotter_ENABLED_CXX20 ON)
    set(JKQtPlotter_QT_CXX_STANDARD 20)
    set(JKQtPlotter_QT_CXX_STANDARD_REQUIRED ON)
    set(JKQtPlotter_QT_CXX_COMPILE_FEATURE cxx_std_20)
    set(JKQtPlotter_BUILD_WITH_PRECOMPILED_HEADERS OFF)
    set(JKQtPlotter_ENABLED_STD_FORMAT OFF)
    set(JKQtPlotter_BUILD_INCLUDE_XITS_FONTS ON)
    set(JKQtPlotter_BUILD_INCLUDE_FIRAMATH_FONTS OFF)
    include("${EDI_ASSISTANT_MATH_SOURCE}/cmake/jkqtplotter_macros.cmake")
    # Edi ships the linked app and original notices, not an unrelated development SDK/header installation.
    function(jkqtplotter_installlibrary_new)
    endfunction()
    add_subdirectory("${EDI_ASSISTANT_MATH_SOURCE}/lib/jkqtcommon" "${CMAKE_CURRENT_BINARY_DIR}/assistant-math/common")
    add_subdirectory("${EDI_ASSISTANT_MATH_SOURCE}/lib/jkqtmathtext" "${CMAKE_CURRENT_BINARY_DIR}/assistant-math/mathtext")
endfunction()
edi_assistant_math_targets()
