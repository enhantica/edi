+    #[cfg(feature = "edi-runtime")]
+    pub async fn edi_policy_proof(&self, turn_id: Option<&str>) -> CodexResult<serde_json::Value> {
+        let turn = self.session.new_default_turn().await;
+        let step = self.session.capture_step_context(turn, &CancellationToken::new()).await?;
+        let schemas = step.tool_router.model_visible_specs();
