# ADR-0056: an app-owned official native runtime, never a global installation.
# These are kind checks before direct I/O, not content/receipt substitutes.
function(_edi_runtime_require_regular path)
    if(IS_SYMLINK "${path}")
        message(FATAL_ERROR "Runtime input/sidecar must not be a link: ${path}")
    endif()
    execute_process(COMMAND test -f "${path}" RESULT_VARIABLE regular)
    if(NOT regular STREQUAL "0")
        message(FATAL_ERROR "Runtime input/sidecar is not a regular file: ${path}")
    endif()
endfunction()

function(_edi_runtime_require_safe_tree root)
    if(NOT IS_DIRECTORY "${root}" OR IS_SYMLINK "${root}")
        message(FATAL_ERROR "Runtime owned path is not a regular directory: ${root}")
    endif()
    file(GLOB_RECURSE tree LIST_DIRECTORIES true "${root}/*")
    foreach(path IN LISTS tree)
        if(IS_SYMLINK "${path}")
            message(FATAL_ERROR "Runtime owned tree contains a link: ${path}")
        endif()
        if(NOT IS_DIRECTORY "${path}")
            _edi_runtime_require_regular("${path}")
        endif()
    endforeach()
endfunction()

# A regular stale temporary belongs to this original fixed sidecar slot. Unlink
# it before writing rather than truncate another hard-linked file's contents.
function(_edi_runtime_prepare_temporary path)
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        _edi_runtime_require_regular("${path}")
        file(REMOVE "${path}")
        if(EXISTS "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "Runtime regular temporary could not be removed: ${path}")
        endif()
    endif()
endfunction()
function(edi_bundle_assistant_runtime)
    if(EMSCRIPTEN)
        return()
    endif()
    option(EDI_ASSISTANT_DEDICATED_RUNTIME "Consume a separately qualified Pixi-installed Edi-only runtime" OFF)
    set(EDI_CODEX_SOURCE_PATCH_SHA256 "")
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
        set(target aarch64-apple-darwin)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
        set(target x86_64-unknown-linux-musl)
    else()
        message(FATAL_ERROR "No qualified native agent input for ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(NOT EDI_ASSISTANT_DEDICATED_RUNTIME)
        # The old task's cached manifest is not an installed package input.
        find_file(_edi_installed_runtime_manifest NAMES input.json
            HINTS "$ENV{PIXI_ENVIRONMENT_PREFIX}" "$ENV{CONDA_PREFIX}"
            PATH_SUFFIXES share/edi/assistant/runtime/0.162.1 NO_DEFAULT_PATH NO_CACHE REQUIRED)
        set(EDI_CODEX_INPUT_MANIFEST "${_edi_installed_runtime_manifest}")
    elseif(NOT EDI_CODEX_INPUT_MANIFEST)
        message(FATAL_ERROR "The explicit dedicated runtime requires its qualified input manifest")
    endif()
    # Preserve the selected filesystem spelling: lexical collapse can cross a
    # symlink/.. differently or erase an actually missing path component.
    if(NOT IS_ABSOLUTE "${EDI_CODEX_INPUT_MANIFEST}")
        set(EDI_CODEX_INPUT_MANIFEST "${CMAKE_CURRENT_SOURCE_DIR}/${EDI_CODEX_INPUT_MANIFEST}")
    endif()
    _edi_runtime_require_regular("${EDI_CODEX_INPUT_MANIFEST}")
    file(READ "${EDI_CODEX_INPUT_MANIFEST}" input)
    foreach(key schema root version target archive_sha256 dedicated files)
        string(JSON input_${key} ERROR_VARIABLE parse_error GET "${input}" "${key}")
        if(parse_error)
            message(FATAL_ERROR "Invalid provisioned agent manifest field ${key}")
        endif()
    endforeach()
    get_filename_component(package_root "${EDI_CODEX_INPUT_MANIFEST}" DIRECTORY)
    if(NOT input_target STREQUAL target OR NOT input_version STREQUAL "0.162.1")
        message(FATAL_ERROR "The installed native agent package identity is incompatible")
    endif()
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        # Existing explicitly qualified development input remains opt-in; not an
        # alternate default acquisition or an unqualified CLI package.
        if(NOT input_schema STREQUAL "edi.assistant.provisioned/1" OR NOT IS_ABSOLUTE "${input_root}")
            message(FATAL_ERROR "The explicit dedicated-runtime input is incompatible")
        endif()
    else()
        if(NOT input_schema STREQUAL "edi.assistant.runtime-package/1" OR NOT input_root STREQUAL "payload")
            message(FATAL_ERROR "The installed native agent package identity is incompatible")
        endif()
        set(input_root "${package_root}/payload")
    endif()
    if(NOT IS_DIRECTORY "${input_root}" OR IS_SYMLINK "${input_root}")
        message(FATAL_ERROR "The provisioned native agent input identity is incompatible")
    endif()
    if((EDI_ASSISTANT_DEDICATED_RUNTIME AND NOT input_dedicated) OR (NOT EDI_ASSISTANT_DEDICATED_RUNTIME AND input_dedicated))
        message(FATAL_ERROR "Provisioned agent flavour differs; install the appropriate locked package")
    endif()
    set(version "${input_version}")
    set(digest "${input_archive_sha256}")
    string(LENGTH "${digest}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid provisioned archive digest")
    endif()
    # The original caller owns the binary directory; this module owns each
    # newly created cache component. Never traverse a preexisting unsafe one.
    if(NOT IS_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" OR IS_SYMLINK "${CMAKE_CURRENT_BINARY_DIR}")
        message(FATAL_ERROR "Runtime binary directory is not a regular owned directory")
    endif()
    set(cache_parent "${CMAKE_CURRENT_BINARY_DIR}/assistant-runtime")
    set(cache "${cache_parent}/${target}")
    foreach(directory IN ITEMS "${cache_parent}" "${cache}")
        if(IS_SYMLINK "${directory}" OR (EXISTS "${directory}" AND NOT IS_DIRECTORY "${directory}"))
            message(FATAL_ERROR "Runtime cache component is not a regular directory: ${directory}")
        endif()
        file(MAKE_DIRECTORY "${directory}")
    endforeach()
    if(EXISTS "${cache}/stage.lock" OR IS_SYMLINK "${cache}/stage.lock")
        _edi_runtime_require_regular("${cache}/stage.lock")
    endif()
    file(LOCK "${cache}/stage.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE locked)
    if(NOT locked STREQUAL "0")
        message(FATAL_ERROR "Another native agent staging owner is active: ${locked}")
    endif()
    _edi_runtime_require_regular("${cache}/stage.lock")
    string(JSON member_count LENGTH "${input}" files)
    set(input_members)
    if(member_count LESS 1)
        message(FATAL_ERROR "The provisioned helper has no verified files")
    endif()
    file(GLOB_RECURSE input_tree LIST_DIRECTORIES true RELATIVE "${input_root}" "${input_root}/*")
    foreach(member IN LISTS input_tree)
        if(IS_SYMLINK "${input_root}/${member}")
            message(FATAL_ERROR "Linked provisioned helper member ${member}")
        endif()
    endforeach()
    math(EXPR last_member "${member_count}-1")
    foreach(index RANGE 0 ${last_member})
        string(JSON member MEMBER "${input}" files ${index})
        if(IS_ABSOLUTE "${member}" OR member MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Escaping provisioned helper member")
        endif()
        list(APPEND input_members "${member}")
        string(JSON expected GET "${input}" files "${member}")
        if(NOT EXISTS "${input_root}/${member}" OR IS_DIRECTORY "${input_root}/${member}" OR IS_SYMLINK "${input_root}/${member}")
            message(FATAL_ERROR "Missing regular provisioned helper member ${member}")
        endif()
        execute_process(COMMAND test -f "${input_root}/${member}" RESULT_VARIABLE regular)
        if(NOT regular EQUAL 0)
            message(FATAL_ERROR "Provisioned helper member is not a regular file: ${member}")
        endif()
        file(SHA256 "${input_root}/${member}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Corrupt provisioned helper member ${member}")
        endif()
        set(member_hash_${member} "${actual}")
    endforeach()
    file(GLOB_RECURSE actual_members LIST_DIRECTORIES false RELATIVE "${input_root}" "${input_root}/*")
    list(SORT actual_members)
    list(SORT input_members)
    if(NOT actual_members STREQUAL input_members)
        message(FATAL_ERROR "The provisioned native helper membership changed")
    endif()
    # Do not create a duplicate payload merely to discover an already-published
    # identity. The installed input is still fully verified on EVERY configure.
    _edi_runtime_require_regular("${input_root}/codex-package.json")
    file(READ "${input_root}/codex-package.json" metadata)
    foreach(pair "layoutVersion|1" "version|${version}" "target|${target}" "variant|codex-app-server" "entrypoint|bin/codex-app-server" "resourcesDir|codex-resources" "pathDir|codex-path")
        string(REPLACE "|" ";" values "${pair}")
        list(GET values 0 key)
        list(GET values 1 expected)
        string(JSON value ERROR_VARIABLE parse_error GET "${metadata}" "${key}")
        if(parse_error OR NOT value STREQUAL expected)
            message(FATAL_ERROR "Provisioned agent package has incompatible ${key}")
        endif()
    endforeach()
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        _edi_runtime_require_regular("${PROJECT_SOURCE_DIR}/tools/assistant-runtime/edi-app-server.patch")
        file(SHA256 "${PROJECT_SOURCE_DIR}/tools/assistant-runtime/edi-app-server.patch" EDI_CODEX_SOURCE_PATCH_SHA256)
    endif()
    set(EDI_CODEX_RUNTIME_VERSION "${version}")
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        foreach(pair "ediPolicySchema|edi.runtime-policy/1" "ediFlavour|edi-app-server/1" "upstreamCommit|092d3acd6bec3e3a14bdc7e7a2810ab628ab759d" "sourcePatchSha256|${EDI_CODEX_SOURCE_PATCH_SHA256}")
            string(REPLACE "|" ";" values "${pair}")
            list(GET values 0 key)
            list(GET values 1 expected)
            string(JSON value ERROR_VARIABLE parse_error GET "${metadata}" "${key}")
            if(parse_error OR NOT value STREQUAL expected)
                message(FATAL_ERROR "Dedicated Edi runtime has incompatible ${key}")
            endif()
        endforeach()
    endif()
    set(required bin/codex-app-server bin/codex-code-mode-host codex-path/rg codex-resources/zsh/bin/zsh)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND required codex-resources/bwrap)
    endif()
    foreach(member IN LISTS required)
        if(NOT EXISTS "${input_root}/${member}" OR IS_DIRECTORY "${input_root}/${member}" OR IS_SYMLINK "${input_root}/${member}")
            message(FATAL_ERROR "Official agent package is missing its regular executable ${member}")
        endif()
        execute_process(COMMAND test -x "${input_root}/${member}" RESULT_VARIABLE executable)
        if(NOT executable EQUAL 0)
            message(FATAL_ERROR "Official agent package executable has wrong permissions: ${member}")
        endif()
    endforeach()
    # Preserve the original final closure: default notices are package-owned;
    # dedicated inputs overlay the same app-owned legal tree at the same paths.
    set(members "${input_members}")
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        set(legal_root "${PROJECT_SOURCE_DIR}/data/assistant/runtime")
        if(NOT IS_DIRECTORY "${legal_root}" OR IS_SYMLINK "${legal_root}")
            message(FATAL_ERROR "The dedicated runtime notices are not an owned regular tree")
        endif()
        file(GLOB_RECURSE legal_tree LIST_DIRECTORIES true RELATIVE "${legal_root}" "${legal_root}/*")
        foreach(legal_member IN LISTS legal_tree)
            if(IS_SYMLINK "${legal_root}/${legal_member}")
                message(FATAL_ERROR "Linked dedicated runtime notice ${legal_member}")
            endif()
            if(IS_DIRECTORY "${legal_root}/${legal_member}")
                continue()
            endif()
            execute_process(COMMAND test -f "${legal_root}/${legal_member}" RESULT_VARIABLE regular)
            if(NOT regular EQUAL 0)
                message(FATAL_ERROR "Dedicated runtime notice is not a regular file: ${legal_member}")
            endif()
            set(member "edi-licenses/${legal_member}")
            list(APPEND members "${member}")
            file(SHA256 "${legal_root}/${legal_member}" member_hash_${member})
        endforeach()
    endif()
    list(REMOVE_DUPLICATES members)
    list(SORT members)
    if(NOT "edi-licenses/LICENSE" IN_LIST members OR NOT "edi-licenses/NOTICE" IN_LIST members)
        message(FATAL_ERROR "The native runtime package lost its original notices")
    endif()
    # Same content address and immutable verifier as the original staged closure.
    # No mtime, installed receipt or existing publication substitutes for hashing.
    set(publication "official-runtime-layout-1;${target};${digest}")
    foreach(member IN LISTS members)
        string(APPEND publication ";${member}:${member_hash_${member}}")
    endforeach()
    string(SHA256 publication "${publication}")
    set(EDI_CODEX_RUNTIME_BUILD_DIR "${cache}/runtime-${publication}")
    set(EDI_CODEX_RUNTIME_TARGET "${target}")
    set(EDI_CODEX_BUILD_APP_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(EDI_CODEX_INSTALL_RELATIVE "../${CMAKE_INSTALL_LIBEXECDIR}/edi/codex")
    set(check "${CMAKE_CURRENT_BINARY_DIR}/verify_assistant_runtime_${publication}.cmake")
    set(check_contents "# Generated from the digest-verified official archive and owned legal resources.\n")
    foreach(member IN LISTS members)
        set(path "${EDI_CODEX_RUNTIME_BUILD_DIR}/${member}")
        string(APPEND check_contents "if(IS_SYMLINK [==[${path}]==])\n message(FATAL_ERROR [==[Linked bundled runtime member ${member}]==])\nendif()\nexecute_process(COMMAND test -f [==[${path}]==] RESULT_VARIABLE regular)\nif(NOT regular EQUAL 0)\n message(FATAL_ERROR [==[Missing regular bundled runtime member ${member}]==])\nendif()\n")
        if(member IN_LIST required)
            string(APPEND check_contents "execute_process(COMMAND test -x [==[${path}]==] RESULT_VARIABLE executable)\nif(NOT executable EQUAL 0)\n message(FATAL_ERROR [==[Nonexecutable bundled runtime member ${member}]==])\nendif()\n")
        endif()
        string(APPEND check_contents "file(SHA256 [==[${path}]==] actual)\nif(NOT actual STREQUAL [==[${member_hash_${member}}]==])\n message(FATAL_ERROR [==[Corrupt bundled runtime member ${member}]==])\nendif()\n")
    endforeach()
    # The verifier is immutable too: a concurrent old build may be reading it.
    if(EXISTS "${check}" OR IS_SYMLINK "${check}")
        _edi_runtime_require_regular("${check}")
        file(READ "${check}" existing_check)
        if(NOT existing_check STREQUAL check_contents)
            message(FATAL_ERROR "Bundled runtime verifier identity changed")
        endif()
    else()
        _edi_runtime_prepare_temporary("${check}.stage")
        file(WRITE "${check}.stage" "${check_contents}")
        _edi_runtime_require_regular("${check}.stage")
        if(EXISTS "${check}" OR IS_SYMLINK "${check}")
            message(FATAL_ERROR "Runtime verifier appeared before publication; it was not replaced")
        endif()
        file(RENAME "${check}.stage" "${check}")
    endif()
    if(EXISTS "${EDI_CODEX_RUNTIME_BUILD_DIR}" OR IS_SYMLINK "${EDI_CODEX_RUNTIME_BUILD_DIR}")
        # Never replace a published identity, even if externally damaged. Reuse
        # verifies it in place, with no transient second complete runtime tree.
        set(validation_root "${EDI_CODEX_RUNTIME_BUILD_DIR}")
    else()
        set(stage "${cache}/stage")
        if(EXISTS "${stage}" OR IS_SYMLINK "${stage}")
            _edi_runtime_require_safe_tree("${stage}")
        endif()
        file(REMOVE_RECURSE "${stage}")
        if(EXISTS "${stage}" OR IS_SYMLINK "${stage}")
            message(FATAL_ERROR "Runtime regular candidate tree could not be removed")
        endif()
        file(MAKE_DIRECTORY "${stage}")
        file(COPY "${input_root}/" DESTINATION "${stage}" USE_SOURCE_PERMISSIONS)
        if(EDI_ASSISTANT_DEDICATED_RUNTIME)
            file(COPY "${legal_root}/" DESTINATION "${stage}/edi-licenses")
        endif()
        set(validation_root "${stage}")
    endif()
    # Both existing and new trees must match the freshly captured expected
    # closure, including extra/missing members, links, bytes and executable modes.
    if(NOT IS_DIRECTORY "${validation_root}" OR IS_SYMLINK "${validation_root}")
        message(FATAL_ERROR "Bundled runtime publication/candidate is not a regular tree")
    endif()
    file(GLOB_RECURSE validation_tree LIST_DIRECTORIES true RELATIVE "${validation_root}" "${validation_root}/*")
    foreach(member IN LISTS validation_tree)
        if(IS_SYMLINK "${validation_root}/${member}")
            message(FATAL_ERROR "Linked bundled runtime member ${member}")
        endif()
    endforeach()
    file(GLOB_RECURSE validation_members LIST_DIRECTORIES false RELATIVE "${validation_root}" "${validation_root}/*")
    list(SORT validation_members)
    if(NOT validation_members STREQUAL members)
        message(FATAL_ERROR "Bundled runtime publication/candidate membership changed")
    endif()
    foreach(member IN LISTS members)
        execute_process(COMMAND test -f "${validation_root}/${member}" RESULT_VARIABLE regular)
        if(NOT regular EQUAL 0)
            message(FATAL_ERROR "Bundled runtime member is not a regular file: ${member}")
        endif()
        file(SHA256 "${validation_root}/${member}" actual)
        if(NOT actual STREQUAL member_hash_${member})
            message(FATAL_ERROR "Corrupt bundled runtime member ${member}")
        endif()
        if(member IN_LIST required)
            execute_process(COMMAND test -x "${validation_root}/${member}" RESULT_VARIABLE executable)
            if(NOT executable EQUAL 0)
                message(FATAL_ERROR "Bundled runtime executable has wrong permissions: ${member}")
            endif()
        endif()
    endforeach()
    if(NOT validation_root STREQUAL EDI_CODEX_RUNTIME_BUILD_DIR)
        # Same lock and absent destination; candidate validation precedes publish.
        if(EXISTS "${EDI_CODEX_RUNTIME_BUILD_DIR}" OR IS_SYMLINK "${EDI_CODEX_RUNTIME_BUILD_DIR}")
            message(FATAL_ERROR "Runtime publication appeared during staging; it was not replaced")
        endif()
        file(RENAME "${stage}" "${EDI_CODEX_RUNTIME_BUILD_DIR}")
    endif()
    _edi_runtime_require_regular("${check}")
    include("${check}")
    _edi_runtime_require_regular("${PROJECT_SOURCE_DIR}/cmake/assistant_runtime_config.hpp.in")
    set(config "${CMAKE_CURRENT_BINARY_DIR}/assistant_runtime_config.hpp")
    if(EXISTS "${config}" OR IS_SYMLINK "${config}")
        _edi_runtime_require_regular("${config}")
    endif()
    # CMake's original configure_file writes outfile.tmp before MoveFileIfDifferent.
    _edi_runtime_prepare_temporary("${config}.tmp")
    configure_file("${PROJECT_SOURCE_DIR}/cmake/assistant_runtime_config.hpp.in" "${config}" @ONLY)
    add_custom_target(edi_assistant_runtime_check
        COMMAND test ! -L "${cache_parent}"
        COMMAND test -d "${cache_parent}"
        COMMAND test ! -L "${cache}"
        COMMAND test -d "${cache}"
        COMMAND test ! -L "${EDI_CODEX_RUNTIME_BUILD_DIR}"
        COMMAND test -d "${EDI_CODEX_RUNTIME_BUILD_DIR}"
        COMMAND test ! -L "${check}"
        COMMAND test -f "${check}"
        COMMAND "${CMAKE_COMMAND}" -P "${check}"
        COMMENT "Verifying bundled assistant runtime" VERBATIM)
    add_dependencies(edi_app_module edi_assistant_runtime_check)
    # install(SCRIPT) would read a FIFO before its body could refuse it. Keep
    # the same original include, guarded in the install driver's own code.
    set(install_check "")
    foreach(directory IN ITEMS "${cache_parent}" "${cache}" "${EDI_CODEX_RUNTIME_BUILD_DIR}")
        string(APPEND install_check "if(IS_SYMLINK [==[${directory}]==] OR NOT IS_DIRECTORY [==[${directory}]==])\n message(FATAL_ERROR [==[Runtime install directory is not a regular owned directory]==])\nendif()\n")
    endforeach()
    string(APPEND install_check "if(IS_SYMLINK [==[${check}]==])\n message(FATAL_ERROR [==[Runtime install verifier must not be a link]==])\nendif()\nexecute_process(COMMAND test -f [==[${check}]==] RESULT_VARIABLE regular)\nif(NOT regular STREQUAL \"0\")\n message(FATAL_ERROR [==[Runtime install verifier is not a regular file]==])\nendif()\ninclude([==[${check}]==])\n")
    install(CODE "${install_check}")
    install(DIRECTORY "${EDI_CODEX_RUNTIME_BUILD_DIR}/" DESTINATION "${CMAKE_INSTALL_LIBEXECDIR}/edi/codex" USE_SOURCE_PERMISSIONS)
endfunction()
