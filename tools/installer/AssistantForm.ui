<!-- The folder field and the choices on the installer's one page (assistantscript.qs, Installer.qs): the folder
     with the space the installation needs under it, then one group of EasyDiffraction, the Maintenance Tool (both
     ticked and fixed), the AI assistant and voice input with their sizes, then the licence and a desktop shortcut on
     Windows and Linux. Also the maintenance tool's choice page when adding, removing or updating: the logo and heading,
     the space line and the same rows; it has no window title, so that page has no header. The Maintenance Tool's row
     and the sizes are there from the start, so the rows are spaced once, with every row in place. -->
<ui version="4.0">
 <class>AssistantForm</class>
 <widget class="QWidget" name="AssistantForm">
  <!-- Takes the page's spare height, so the boxes sit right under the folder field instead of lower down. -->
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
    <horstretch>0</horstretch>
    <verstretch>1</verstretch>
   </sizepolicy>
  </property>
  <!-- Every row is a widget of its own, hidden as a whole: a row whose box is hidden inside it still takes 7 px on
       macOS (the hidden box's layout margins). Nor is a box ever put straight in the column. On macOS a check box reaches 2 px past
       its cell (its layout margins), and a column holding one moves all its rows right to make room, so boxes and
       text started 2 px apart. A row's own layout takes up its box's margins, so every row starts at the column's
       edge and each row's frame is its cell: an 8 px gap between the rows of a group, 24 between groups. -->
  <!-- The column has no spacing of its own: above each row a gap widget, 8 high, which Installer.qs (settleForm)
       sets once the page shows so that the drawn frames stand one row gap apart, a new group (the folder, the
       choices, the notes under them) and the rest 32 under the logo.
       A fixed spacing cannot: a row is not always exactly its drawn frames (on macOS the licence row is 1 px more). -->
  <layout class="QVBoxLayout" name="AssistantLayout">
   <property name="spacing">
    <number>0</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <!-- The page's own row gap (8, Installer.qs) is the step under the folder field. -->
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QWidget" name="LogoBox">
     <property name="visible">
      <bool>false</bool>
     </property>
     <layout class="QHBoxLayout" name="LogoRow">
      <property name="spacing">
       <number>8</number>
      </property>
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
      <item>
       <widget class="QLabel" name="FormLogo">
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <!-- The folder and Browse, the installer's own (Installer.qs keeps the Framework's field, hidden, the one the
        installation reads): in this column they start at its edge and stand one row gap above the boxes. -->
   <item>
    <widget class="QWidget" name="FolderRowGap">
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>8</height>
      </size>
     </property>
     <property name="maximumSize">
      <size>
       <width>16777215</width>
       <height>8</height>
      </size>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="FolderBox">
     <property name="visible">
      <bool>false</bool>
     </property>
     <layout class="QHBoxLayout" name="FolderRow">
      <property name="spacing">
       <number>8</number>
      </property>
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
      <item>
       <widget class="QLineEdit" name="FolderLineEdit">
        <property name="accessibleName">
         <string>Install to</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="FolderBrowseButton">
        <property name="text">
         <string>Browse…</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="SpaceRowGap">
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>8</height>
      </size>
     </property>
     <property name="maximumSize">
      <size>
       <width>16777215</width>
       <height>8</height>
      </size>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="SpaceBox">
     <layout class="QHBoxLayout" name="SpaceRow">
      <property name="spacing">
       <number>8</number>
      </property>
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
