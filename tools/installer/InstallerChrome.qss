/* The installer window around its pages: background, header, step list, wizard buttons and message boxes. The
   Framework loads this one stylesheet for the whole app before any script runs and offers scripts no way to change
   it, so it follows the system's light or dark palette, with edi's borders as translucent shades that give the app's
   colours on both. The pages themselves get edi's exact light or dark theme from Installer.qs (Installer.qss). */

QWizard, QWidget#SideWidget, QListWidget#PageListWidget, QWizard > QWidget > QWidget, QDialog, QMessageBox {
    background-color: palette(window);
    color: palette(window-text);
}

QWizard QWidget, QDialog QWidget {
    font-size: @FONT_PX@px;
}

/* The empty subtitle keeps the Modern header visible without adding text height. */
QWizard > QWidget > QWidget > QLabel[wordWrap="true"] {
    font-size: 5px;
}

/* The step list: upcoming steps muted, the current one in bold. */
QListWidget#PageListWidget {
    border: none;
    outline: none;
}

QListWidget#PageListWidget::item {
    padding-left: @STEP_LIST_INSET@px;
    color: palette(window-text);
    background: transparent;
    border: none;
}

QListWidget#PageListWidget::item:disabled {
    color: #888888;  /* the app's dark minor grey, readable on the light window too */
}

QListWidget#PageListWidget::item:selected, QListWidget#PageListWidget::item:selected:active,
QListWidget#PageListWidget::item:selected:!active, QListWidget#PageListWidget::item:selected:disabled {
    color: palette(window-text);
    background: transparent;
    font-weight: bold;
}

/* Buttons, as the app's side bar buttons: one look for all, no default-button or focus ring. */
QPushButton {
    color: palette(window-text);
    background-color: transparent;
    /* Grey at a quarter: a little darker than a light window, a little lighter than a dark one. */
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 2px;
    min-height: @CONTROL_INNER_PX@px;
    max-height: @CONTROL_INNER_PX@px;
    min-width: 70px;
    padding: 0 @FONT_PX@px;
    outline: none;
}

QPushButton:default, QPushButton:focus {
    border-color: rgba(128, 128, 128, 0.25);
}

/* Hovered or pressed, the border takes the text's accent. */
QPushButton:hover, QPushButton:pressed, QPushButton:checked {
    color: @ACCENT@;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: @ACCENT@;
}

QPushButton:disabled {
    color: #888888;  /* the app's dark minor grey, readable on the light window too */
    border-color: transparent;
}

/* The Framework's questions and warnings ("Do you want to quit", "already exists") as the pages read: the pages'
   text at its normal weight (Qt makes it bold on macOS), and no large icon. Those that warn or refuse (the
   Framework's warning and critical ones) take the app's small warning sign (render_images.qml); a question or a
   note takes none (owner point 35). Matched by the icon the Framework gave the pop-up. */
QMessageBox[icon="Question"], QMessageBox[icon="Information"], QMessageBox[icon="4"], QMessageBox[icon="1"] {
    qproperty-icon: NoIcon;
}

QMessageBox[icon="Warning"], QMessageBox[icon="Critical"], QMessageBox[icon="2"], QMessageBox[icon="3"] {
    qproperty-iconPixmap: url(:/metadata/edi/warning.png);
}

/* The wizard buttons' icons, as the app's buttons carry them: the buttons are the Framework's, one per role, so each
   role has one icon whatever the page names the button (Next is also Install and Try again, the commit button Update,
   Uninstall and Make more changes). The Maintenance Tool's last page finishes with its Cancel button, made the
   default there: as default it takes the done icon. A disabled Back or commit button takes no room (below) and shows
   no icon. */
/* A button's width is reckoned from its text alone, without the icon a stylesheet gives it, and the icon and text
   are drawn inside that width: so a wizard button's inside is at least as wide as the icon (14), the 4 px beside it
   and its longest text ("Try again", about 64 px at the 14 px text), with room to spare: 90 px. */
QPushButton#__qt__passive_wizardbutton0, QPushButton#__qt__passive_wizardbutton1, QPushButton#qt_wizard_commit,
QPushButton#qt_wizard_finish, QPushButton#qt_wizard_cancel {
    min-width: 90px;
}

QPushButton#__qt__passive_wizardbutton0 {
    icon: url(:/metadata/edi/button-back.png);
    icon-size: 14px;
}

QPushButton#__qt__passive_wizardbutton1 {
    icon: url(:/metadata/edi/button-next.png);
    icon-size: 14px;
}

QPushButton#qt_wizard_commit, QPushButton#qt_wizard_finish, QPushButton#qt_wizard_cancel:default {
    icon: url(:/metadata/edi/button-done.png);
    icon-size: 14px;
}

QPushButton#qt_wizard_cancel {
    icon: url(:/metadata/edi/button-cancel.png);
    icon-size: 14px;
}

/* The commit button outlined (Make more changes beside Finish on the Maintenance Tool's last page) takes the outlined
   grey. */
QPushButton#qt_wizard_commit:!default {
    icon: url(:/metadata/edi/button-done-plain.png);
}

QPushButton#__qt__passive_wizardbutton0:disabled, QPushButton#qt_wizard_commit:disabled {
    icon: url(none);
}

/* A pop-up in one colour, the window's own (the window behind it is darkened), with a faint border near that colour
   and room around its text. Without a window frame (a window manager may draw none) it still reads as a dialog, not
   as text on the page. */
QMessageBox {
    background-color: palette(window);
    border: 1px solid rgba(128, 128, 128, 0.2);
}

/* Everything inside it on the panel's colour (on macOS the message label otherwise draws the window's grey). */
QMessageBox QWidget, QMessageBox QLabel#qt_msgbox_label {
    background-color: transparent;
}

/* Room around the message inside the panel: Qt lays it in a grid whose margins a stylesheet cannot reach (padding
   on the box itself is ignored), so the label carries it, 12 px above the text and 24 px between the text and the
   buttons, and 20 px on its right, which with the grid's margin matches the space left of the text (32 px). A label
   given padding would also indent its text by half an "x": none. */
QMessageBox QLabel#qt_msgbox_label {
    padding: 12px 20px 24px 0;
    qproperty-indent: 0;
}

QMessageBox QLabel {
    color: palette(window-text);
    font-weight: normal;
}

/* Their buttons without icons (Linux styles give Yes, No and OK one), as every other button. */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QMessageBox QLabel#qt_msgboxex_icon_label {
    margin: 14px 0 0 0;
    padding: 0;
}

/* The main action (Install, Update, Finish: the default button) filled with the app's accent; the others quiet. */
QPushButton:default {
    color: white;
    background-color: @ACCENT@;
    border-color: @ACCENT@;
}

QPushButton:default:hover, QPushButton:default:pressed {
    color: white;
    background-color: #0091cb;
    border-color: #0091cb;
}

/* In a pop-up the button Enter presses is the filled one, as everywhere: that is the platform's choice for the
   Framework's own pop-ups (for the quit question No on macOS, Yes on Linux and Windows), which a script cannot change,
   so the fill shows what Enter does rather than which answer is safe. */

/* The page's frame takes the window's colour (Qt may fill it with the base colour, a white card). */
QWizard > QWidget > QFrame {
    border: none;
    background-color: palette(window);
}

/* No line above the buttons, and no header (the pages have no titles): Qt draws both in its own private
   widgets, whose classes a stylesheet sees as exactly QWidget, which ".QWidget" matches and nothing else here. */
QWizard > QWidget > .QWidget {
    min-height: 0;
    max-height: 0;
    qproperty-maximumHeight: 0;
}

/* A wizard button with nothing to do on a page (Back and Install while installing) takes no room. */
QPushButton#__qt__passive_wizardbutton0:disabled, QPushButton#qt_wizard_commit:disabled,
QPushButton#qt_wizard_commit:default:disabled {
    min-width: 0;
    max-width: 0;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: transparent;
    qproperty-iconSize: 0px 0px;
}
