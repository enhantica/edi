        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="LicenseLink">
        <!-- Takes the rest of the row, so the row needs no spacer: a spacer would keep a row whose widgets are
             hidden (the maintenance tool's) in the column, one gap too many. -->
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="openExternalLinks">
