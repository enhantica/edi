    <widget class="QWidget" name="AssistantBox">
     <layout class="QHBoxLayout" name="AssistantRow">
      <property name="spacing">
       <number>8</number>
      </property>
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
