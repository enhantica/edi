# NCAF WISH bank 5+6 fixture project for crysta MVP1.
#
# Source workflow:
#   <checkout>/easyscience/diffraction-lib
#   docs/docs/tutorials/refine-ncaf-wish.py
#   tests/integration/fitting/test_powder-diffraction_time-of-flight.py
#
# This file intentionally uses EasyDiffraction's EDI spelling. The visible
# oracle generator parses it, builds an EasyDiffraction project, selects the
# CrysPy calculator, and writes the committed goldens.

data_ncaf

_edi.schema_version 2

_cell.length_a 10.250256
_cell.length_b 10.250256
_cell.length_c 10.250256
_cell.angle_alpha 90.0
_cell.angle_beta 90.0
_cell.angle_gamma 90.0

_space_group.name_h_m "I 21 3"
_space_group.coord_system_code 1

