# C++ static analysis over edi's own code (ADR-0093), any finding an error in CI.
# The groups that find faults: the Clang Static Analyzer, bugprone, performance and cert, each with the
# exceptions crysta's curated set makes. crysta's style groups (readability, modernize, misc,
# cppcoreguidelines) follow in a sweep of their own. A line the checks misread names the check it
# silences and why: `// NOLINT(<check>): <reason>`.
# The analyzer's opt-in Padding hint is off: it asks for members in size order, and the code orders them
# by meaning; it reports memory layout, never a fault. performance-enum-size is off too: most of edi's
# enums are Qt's (model roles from Qt::UserRole, Q_ENUM types QML reads), which the meta-object system
# handles as int. bugprone-empty-catch is off: edi's teardown and optional presentation steps are noexcept and
# drop a failure on purpose. performance-no-int-to-ptr is off: Qt table models here key rows by small integers.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  bugprone-*,
  performance-*,
  cert-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-throwing-static-initialization,
  -cert-err58-cpp,
  -cert-err33-c,
  -performance-enum-size,
  -bugprone-empty-catch,
  -performance-no-int-to-ptr
WarningsAsErrors: ''
HeaderFilterRegex: 'core/.*'
# libc++'s allocator throws bad_array_new_length only for a size past max_size(), a request no allocation can meet, and
# edi never throws it: libstdc++ reports the same case as bad_alloc from operator new, which the check does not count,
# so the two libraries read alike (ADR-0093).
CheckOptions:
  bugprone-exception-escape.IgnoredExceptions: 'bad_array_new_length'
