<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!-- The installing page's content: the logo, one status line, and the progress bar with its percentage beside it
     (Installer.qs feeds them from the Framework's own label and bar, which are hidden: the Framework rewrites its
     label on every step). -->
<ui version="4.0">
 <class>ProgressForm</class>
 <widget class="QWidget" name="ProgressForm">
  <!-- Takes the page's spare height, with its content at the top like every other page's. -->
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
    <horstretch>0</horstretch>
    <verstretch>1</verstretch>
   </sizepolicy>
  </property>
  <layout class="QVBoxLayout" name="ProgressColumn">
   <!-- 12, so the thin bar, centred in its row, sits one 16-point step under the status line. -->
   <property name="spacing">
    <number>12</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QLabel" name="EdiProgressLogo"/>
   </item>
   <item>
    <widget class="QLabel" name="EdiProgressStatus"/>
   </item>
   <item>
    <layout class="QHBoxLayout" name="ProgressLayout">
     <property name="spacing">
      <number>8</number>
     </property>
     <item>
      <widget class="QProgressBar" name="EdiProgressBar">
       <property name="textVisible">
        <bool>false</bool>
       </property>
       <property name="value">
        <number>0</number>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="EdiProgressPercent">
       <property name="minimumSize">
        <size>
         <width>44</width>
         <height>0</height>
        </size>
       </property>
       <property name="alignment">
        <set>Qt::AlignRight|Qt::AlignVCenter</set>
       </property>
       <property name="text">
        <string>0%</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="ProgressSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
</ui>
