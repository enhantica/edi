# Byte-preserving product text without compiler-sized string literals (ADR-0074).
function(edi_embed_text name contents)
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid embedded text storage name")
    endif()
    string(HEX "${contents}" bytes)
    string(LENGTH "${bytes}" hex_length)
    math(EXPR length "${hex_length} / 2")
    set(declaration "static const char ${name}[] = {\n")
    set(offset 0)
    while(offset LESS hex_length)
        math(EXPR take "${hex_length} - ${offset}")
        if(take GREATER 1600)
            set(take 1600)
        endif()
        string(SUBSTRING "${bytes}" ${offset} ${take} row)
        string(REGEX REPLACE "(..)" "'\\\\x\\1'," row "${row}")
        string(APPEND declaration "${row}\n")
        math(EXPR offset "${offset} + ${take}")
    endwhile()
    string(APPEND declaration "'\\0'};\n")
    set(${name}_declaration "${declaration}" PARENT_SCOPE)
    set(${name}_size "${length}" PARENT_SCOPE)
endfunction()
