/* The installer window around its pages: background, header, step list, wizard buttons and message boxes. The
   Framework loads this one stylesheet for the whole app before any script runs and offers scripts no way to change
   it, so it follows the system's light or dark palette, with edi's borders as translucent shades that give the app's
   colours on both. The pages themselves get edi's exact light or dark theme from Installer.qs (Installer.qss). */

QWizard, QWidget#SideWidget, QListWidget#PageListWidget, QWizard > QWidget > QWidget, QDialog, QMessageBox {
    background-color: palette(window);
    color: palette(window-text);
}

QWizard QWidget, QDialog QWidget {
    font-size: @FONT_PX@px;
}

/* The empty subtitle keeps the Modern header visible without adding text height. */
QWizard > QWidget > QWidget > QLabel[wordWrap="true"] {
    font-size: 5px;
}

/* The step list: upcoming steps muted, the current one in bold. */
QListWidget#PageListWidget {
    border: none;
    outline: none;
}

QListWidget#PageListWidget::item {
    padding-left: @STEP_LIST_INSET@px;
    color: palette(window-text);
    background: transparent;
    border: none;
}

QListWidget#PageListWidget::item:disabled {
    color: #888888;  /* the app's dark minor grey, readable on the light window too */
}

QListWidget#PageListWidget::item:selected, QListWidget#PageListWidget::item:selected:active,
QListWidget#PageListWidget::item:selected:!active, QListWidget#PageListWidget::item:selected:disabled {
    color: palette(window-text);
    background: transparent;
    font-weight: bold;
}

/* Buttons, as the app's side bar buttons: one look for all, no default-button or focus ring. */
QPushButton {
    color: palette(window-text);
    background-color: transparent;
    /* Grey at a quarter: a little darker than a light window, a little lighter than a dark one. */
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 2px;
    min-height: @CONTROL_INNER_PX@px;
    max-height: @CONTROL_INNER_PX@px;
    min-width: 70px;
    padding: 0 @FONT_PX@px;
    outline: none;
}

QPushButton:default, QPushButton:focus {
    border-color: rgba(128, 128, 128, 0.25);
}

QPushButton:hover, QPushButton:pressed, QPushButton:checked {
    color: @ACCENT@;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: transparent;
}

QPushButton:disabled {
    color: #888888;  /* the app's dark minor grey, readable on the light window too */
    border-color: transparent;
}

QMessageBox QLabel {
    color: palette(window-text);
}

/* The main action (Install, Update, Finish: the default button) filled with the app's accent; the others quiet. */
QPushButton:default {
    color: white;
    background-color: @ACCENT@;
    border-color: @ACCENT@;
}

QPushButton:default:hover, QPushButton:default:pressed {
    color: white;
    background-color: #0091cb;
    border-color: #0091cb;
}

/* The app's icons on the wizard's buttons (Qt names them by their WizardButton number). */
QPushButton#__qt__passive_wizardbutton0 {
    qproperty-icon: url(:/metadata/edi/back.png);
    qproperty-iconSize: 16px 16px;
}

QPushButton#qt_wizard_finish {
    qproperty-icon: url(:/metadata/edi/finish.png);
    qproperty-iconSize: 16px 16px;
}

/* No frame around the page: its content sits on the window (Qt's Mac style draws a raised box). */
QWizard > QWidget > QFrame {
    border: none;
    background-color: palette(window);  /* Qt fills it with the base colour, a white card, otherwise */
    min-width: 560px;  /* the page fills the window; Qt's Mac style leaves it at its own width */
}

/* A wizard button with nothing to do on a page (Back and Install while installing) takes no room. */
QPushButton#__qt__passive_wizardbutton0:disabled, QPushButton#qt_wizard_commit:disabled,
QPushButton#qt_wizard_commit:default:disabled {
    min-width: 0;
    max-width: 0;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: transparent;
    qproperty-iconSize: 0px 0px;
}
