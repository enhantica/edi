# Every executable edi builds for Windows carries cmake/windows/utf8.manifest (ADR-0109). Called once the whole tree is
# configured, so it reaches the executables of every directory, test and tool programs included.
function(edi_apply_utf8_manifest)
    set(manifest "${PROJECT_SOURCE_DIR}/cmake/windows/utf8.manifest")
    set(directories "${PROJECT_SOURCE_DIR}")
    set(missing)
    while(directories)
        list(POP_FRONT directories directory)
        get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        list(APPEND directories ${children})
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(target IN LISTS targets)
            get_target_property(type ${target} TYPE)
            if(NOT type STREQUAL "EXECUTABLE")
                continue()
            endif()
            target_sources(${target} PRIVATE "${manifest}")
            get_target_property(sources ${target} SOURCES)
            if(NOT manifest IN_LIST sources)
                list(APPEND missing ${target})
            endif()
        endforeach()
    endwhile()
    if(missing)
        message(FATAL_ERROR "edi: these executables lack the UTF-8 code-page manifest: ${missing}")
    endif()
endfunction()
