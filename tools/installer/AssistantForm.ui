<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!-- The choices on the installer's one page, under the folder field (assistantscript.qs, Installer.qs): the AI
     assistant, the licence, a desktop shortcut on Windows and Linux, and the space the installation needs. -->
<ui version="4.0">
 <class>AssistantForm</class>
 <widget class="QWidget" name="AssistantForm">
  <property name="windowTitle">
   <string>AI assistant</string>
  </property>
  <!-- Takes the page's spare height, so the boxes sit right under the folder field instead of lower down. -->
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
    <horstretch>0</horstretch>
    <verstretch>1</verstretch>
   </sizepolicy>
  </property>
  <layout class="QVBoxLayout" name="AssistantLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QCheckBox" name="AssistantCheckBox">
     <property name="text">
      <string>Also install the AI assistant</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="LicenseRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <item>
      <widget class="QCheckBox" name="LicenseCheckBox">
       <property name="text">
        <string>I accept the GNU GPL v3 license</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="LicenseLink">
       <property name="openExternalLinks">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="LicenseSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QCheckBox" name="ShortcutCheckBox">
     <property name="text">
      <string>Add a desktop shortcut</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="NoticeLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="openExternalLinks">
      <bool>false</bool>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="AssistantSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
    </spacer>
   </item>
   <item>
    <widget class="QLabel" name="SpaceLabel"/>
   </item>
  </layout>
 </widget>
</ui>
