+//! Immutable ceiling for the dedicated Edi app-server build.
+//! This module does not grant filesystem or provider access.
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use codex_extension_api::{ExtensionDataInit, SessionIsolation, ToolPolicy};
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::error::{CodexErr, Result};
+use codex_tools::{ToolName, ToolSpec, ResponsesApiNamespaceTool};
+use serde_json::{Value, json};
+
+pub const SCHEMA: &str = "edi.runtime-policy/1";
+pub const FLAVOUR: &str = "edi-app-server/1";
+const NAMES: &[&str] = &["inspect_project", "list_parameters", "diagnostics", "set_parameters", "set_free", "run_fit", "create_cwl_project", "acquire_inputs", "save_project", "add_relations", "edit_relation", "edit_background", "load_structure", "create_experiment", "set_experiment_type", "load_data", "read_selected_file", "create_structure", "edit_structure", "edit_atom", "edit_experiment"];
+
+pub(crate) struct EdiTurnCeiling(pub Arc<EdiCeiling>);
+
+#[derive(Debug)]
+pub struct EdiCeiling {
+    requested: Vec<DynamicToolSpec>,
+    expected: BTreeMap<String, Value>,
+}
+fn invalid() -> CodexErr { CodexErr::InvalidRequest("Edi runtime policy mismatch".into()) }
+impl EdiCeiling {
+    pub fn capture(tools: &[DynamicToolSpec]) -> Result<Self> {
+        if tools.len() != NAMES.len() { return Err(invalid()); }
+        let mut expected = BTreeMap::new();
+        for tool in tools {
+            let DynamicToolSpec::Function(function) = tool else { return Err(invalid()); };
+            let closed_object = |schema: &Value| schema.get("type").and_then(Value::as_str) == Some("object") &&
+                schema.get("properties").is_some_and(Value::is_object) &&
+                schema.get("additionalProperties") == Some(&Value::Bool(false));
+            let closed_union = function.input_schema.as_object().is_some_and(|root| root.len() == 1 &&
+                root.get("oneOf").and_then(Value::as_array).is_some_and(|branches| !branches.is_empty() &&
+                    branches.iter().all(|branch| closed_object(branch) && branch.get("oneOf").is_none())));
+            if function.defer_loading || !NAMES.contains(&function.name.as_str()) ||
+                !(closed_object(&function.input_schema) || closed_union) {
+                return Err(invalid());
+            }
+            let mut parsed = codex_tools::dynamic_tool_to_responses_api_tool(function).map_err(|_| invalid())?;
+            parsed.defer_loading = None;
+            let schema = serde_json::to_value(parsed).map_err(|_| invalid())?;
+            if expected.insert(function.name.clone(), schema).is_some() { return Err(invalid()); }
+        }
+        Ok(Self { requested: tools.to_vec(), expected })
+    }
+    pub fn install(self, init: &mut ExtensionDataInit) {
+        init.insert(ToolPolicy {
+            allowed_tools: Some(self.expected.keys().map(|name| ToolName::namespaced("functions", name)).collect()),
+            require_managed_sandbox: false,
+            require_unified_exec: true,
+            expose_additional_permissions: false,
+        });
+        init.insert(SessionIsolation::Isolated);
+        init.insert(self);
+    }
+    pub fn same_request(&self, tools: &[DynamicToolSpec]) -> bool { self.requested == tools }
+    pub fn verify(&self, advertised: &[ToolSpec], dispatch: &[ToolSpec]) -> Result<()> {
+        fn parsed(specs: &[ToolSpec]) -> Result<BTreeMap<String, Value>> {
+            fn insert(map: &mut BTreeMap<String,Value>, tool: &codex_tools::ResponsesApiTool) -> Result<()> {
+                if tool.defer_loading == Some(true) || map.insert(tool.name.clone(), serde_json::to_value(tool).map_err(|_| invalid())?).is_some() { return Err(invalid()); }
+                Ok(())
+            }
+            let mut map = BTreeMap::new();
+            for spec in specs { match spec {
+                ToolSpec::Function(tool) => insert(&mut map, tool)?,
+                ToolSpec::Namespace(namespace) if namespace.name == "functions" => for tool in &namespace.tools {
+                    let ResponsesApiNamespaceTool::Function(tool) = tool else { return Err(invalid()); };
+                    insert(&mut map, tool)?;
+                },
+                _ => return Err(invalid()),
+            }}
+            Ok(map)
+        }
+        if parsed(advertised)? != self.expected || parsed(dispatch)? != self.expected || self.expected.is_empty() { return Err(invalid()); }
+        Ok(())
+    }
+    // Compare the actual encoded catalogue after the original API/Lite
+    // conversion. No advertised spelling can introduce a second namespace or
+    // hide a callable behind a stale typed prompt.
+    fn verify_encoded_tools(&self, tools: &[Value]) -> Result<()> {
+        fn insert(map: &mut BTreeMap<String, Value>, value: &Value) -> Result<()> {
+            let mut function = value.as_object().cloned().ok_or_else(invalid)?;
+            if function.remove("type") != Some(Value::String("function".into())) { return Err(invalid()); }
+            let name = function.get("name").and_then(Value::as_str).ok_or_else(invalid)?.to_owned();
+            if map.insert(name, Value::Object(function)).is_some() { return Err(invalid()); }
+            Ok(())
+        }
+        let mut parsed = BTreeMap::new();
+        for tool in tools {
+            if tool.get("type").and_then(Value::as_str) == Some("namespace") {
+                let namespace = tool.as_object().ok_or_else(invalid)?;
+                if namespace.get("name").and_then(Value::as_str) != Some("functions")
+                    || namespace.get("description").and_then(Value::as_str) != Some(codex_tools::default_namespace_description("functions").as_str())
+                    || namespace.keys().any(|key| !matches!(key.as_str(), "type" | "name" | "description" | "tools"))
+                { return Err(invalid()); }
+                for function in namespace.get("tools").and_then(Value::as_array).ok_or_else(invalid)? { insert(&mut parsed, function)?; }
+            } else { insert(&mut parsed, tool)?; }
+        }
+        if self.expected.is_empty() || parsed != self.expected { return Err(invalid()); }
+        Ok(())
+    }
+    pub fn verify_encoded(&self, input: &[codex_protocol::models::ResponseItem], tools: Option<Value>, lite: bool) -> Result<()> {
+        use codex_protocol::models::ResponseItem;
+        let mut additional = 0;
+        for item in input {
+            if let ResponseItem::AdditionalTools { role, tools, .. } = item {
+                additional += 1;
+                if !lite || role != "developer" { return Err(invalid()); }
+                self.verify_encoded_tools(tools)?;
+            } else { self.verify_input(std::slice::from_ref(item))?; }
+        }
+        if lite {
+            if tools.is_some() || additional != 1 { return Err(invalid()); }
+        } else {
+            if additional != 0 { return Err(invalid()); }
+            self.verify_encoded_tools(tools.as_ref().and_then(Value::as_array).ok_or_else(invalid)?)?;
+        }
+        Ok(())
+    }
+    pub fn verify_input(&self, input: &[codex_protocol::models::ResponseItem]) -> Result<()> {
+        use codex_protocol::models::{ResponseItem, ContentItem, FunctionCallOutputBody, FunctionCallOutputContentItem};
+        for item in input {
+            let refused = match item {
+                ResponseItem::Message { role, content, .. } =>
+                    !matches!(role.as_str(), "user" | "assistant" | "developer") || content.iter().any(|part|
+                        !matches!(part, ContentItem::InputText { .. } | ContentItem::OutputText { .. })),
+                ResponseItem::FunctionCallOutput { output, name, namespace, .. } => {
+                    if name.as_ref().is_some_and(|value| !self.expected.contains_key(value))
+                        || namespace.as_deref().is_some_and(|value| value != "functions") { return Err(invalid()); }
+                    match &output.body {
+                    FunctionCallOutputBody::Text(_) => false,
+                    FunctionCallOutputBody::ContentItems(items) => items.iter().any(|part|
+                        !matches!(part, FunctionCallOutputContentItem::InputText { .. })),
+                    }
+                },
+                ResponseItem::FunctionCall { name, namespace, .. } =>
+                    !self.expected.contains_key(name) || namespace.as_deref().is_some_and(|value| value != "functions"),
+                ResponseItem::Reasoning { .. } => false,
+                // Unknown, agent, custom, compaction and durable configuration
+                // items have no admitted role in this isolated app thread.
+                _ => true,
+            };
+            if refused { return Err(invalid()); }
+        }
+        Ok(())
+    }
+    pub fn proof(&self, thread: &str, turn: Option<&str>, schemas: &[ToolSpec]) -> Result<Value> {
+        let patch = option_env!("EDI_SOURCE_PATCH_SHA256").ok_or_else(invalid)?;
+        if patch.len() != 64 || !patch.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(invalid()); }
+        Ok(json!({"schema":SCHEMA,"flavour":FLAVOUR,"upstreamVersion":"0.162.1",
+            "upstreamCommit":"092d3acd6bec3e3a14bdc7e7a2810ab628ab759d","sourcePatchSha256":patch,
+            "threadId":thread,"turnId":turn,"isolation":"isolated","toolMode":"direct",
+            "sandbox":"readOnly","approvalPolicy":"never","modelNetwork":false,
+            "requestedTools":self.requested,"advertisedTools":schemas,"dispatchEqualsAdvertisement":true}))
+    }
+}
+pub(crate) fn ceiling(init: &ExtensionDataInit) -> Result<Arc<EdiCeiling>> {
+    init.get::<EdiCeiling>().ok_or_else(invalid)
+}
