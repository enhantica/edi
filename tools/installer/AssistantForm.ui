<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!-- The choices on the installer's one page, under the folder field (assistantscript.qs, Installer.qs): the AI
     assistant, the licence, a desktop shortcut on Windows and Linux, and the space the installation needs. Also the
     maintenance tool's choice page when adding, removing or updating: the logo, EasyDiffraction (always kept, so
     ticked and fixed) and the AI assistant; it has no window title, so that page
     has no header. -->
<ui version="4.0">
 <class>AssistantForm</class>
 <widget class="QWidget" name="AssistantForm">
  <!-- Takes the page's spare height, so the boxes sit right under the folder field instead of lower down. -->
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
    <horstretch>0</horstretch>
    <verstretch>1</verstretch>
   </sizepolicy>
  </property>
  <!-- Every row is a layout of its own, never a widget straight in the column. On macOS a check box reaches 2 px past
       its cell (its layout margins), and a column holding one moves all its rows right to make room, so boxes and
       text started 2 px apart. A row's own layout takes up its box's margins, so every row starts at the column's
       edge and each row's frame is its cell: one 8 px gap between all rows. -->
  <layout class="QVBoxLayout" name="AssistantLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <!-- The page's own row gap (8, Installer.qs) is the step under the folder field. -->
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <!-- The logo stands one step (16) above the rows: the row gap and 8 under it. -->
    <layout class="QHBoxLayout" name="LogoRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>8</number>
     </property>
     <item>
      <widget class="QLabel" name="FormLogo">
       <property name="visible">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="AppRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QCheckBox" name="AppCheckBox">
       <property name="visible">
        <bool>false</bool>
       </property>
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
       <property name="text">
        <string>EasyDiffraction</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="AssistantRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QCheckBox" name="AssistantCheckBox">
       <property name="text">
        <string>Also install the AI assistant</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="LicenseRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QCheckBox" name="LicenseCheckBox">
       <property name="text">
        <string>I accept the GNU GPL v3 license</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="LicenseLink">
       <!-- Takes the rest of the row, so the row needs no spacer: a spacer would keep a row whose widgets are
            hidden (the maintenance tool's) in the column, one gap too many. -->
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
         <horstretch>1</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="openExternalLinks">
        <bool>true</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="ShortcutRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QCheckBox" name="ShortcutCheckBox">
       <property name="text">
        <string>Add a desktop shortcut</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="NoticeRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QLabel" name="NoticeLabel">
       <property name="wordWrap">
        <bool>true</bool>
       </property>
       <property name="openExternalLinks">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="SpaceRow">
     <property name="spacing">
      <number>8</number>
     </property>
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>0</number>
     </property>
     <item>
      <widget class="QLabel" name="SpaceLabel">
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="AssistantSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
</ui>
