   <!-- Voice input, under the AI assistant: shown where the installer has the component (Installer.qs). -->
   <item>
    <widget class="QWidget" name="VoiceRowGap">
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>8</height>
      </size>
     </property>
     <property name="maximumSize">
      <size>
       <width>16777215</width>
