    {
      "entry": "Session::beginSave",
      "owner": "save operation through held settlement",
      "proof": "test_request_owner_boundaries.py"
    },
    {
      "entry": "ProjectViewModel::fetchCollectionData",
      "owner": "each waiter and its admitted dependency set",
      "proof": "test_fetch_operation_ownership.py"
    },
    {
      "entry": "ProjectViewModel::publishFilledData",
      "owner": "retained project through every synchronous subscriber",
      "proof": "test_fetch_operation_ownership.py"
    },
    {
      "entry": "edi_app::fetch_from / edi_app::fetch_url",
      "owner": "tutorial, example, checked-file or query request",
      "proof": "test_file_fetch_owner_boundaries.py"
    },
    {
      "entry": "QFile / QDir / std::filesystem copy and rename; core archive and browser write",
      "owner": "sealed exact save snapshot at user publication",
      "proof": "test_sealed_publication_contract.py"
    },
    {
      "entry": "ApplicationInfo::afterChanges / ApplicationInfo::projectWindowClosing",
      "owner": "held dirty truth with deferred notifications",
      "proof": "test_held_edit_native_guards.py"
    },
    {
      "entry": "Session browser finishOpen and stored/recovery open",
      "owner": "current owner, replacement generation and held revision",
      "proof": "test_held_edit_loss_guards.py"
    },
    {
      "entry": "OnlineSearch::search / fetch / loadChunk / loadMore",
      "owner": "each COD count, detail, list and page continuation retains query generation",
      "proof": "test_cod_query_ownership.py"
    },
    {
      "entry": "ProjectViewModel::settleHeld / ProjectViewModel::edited",
      "owner": "dirty truth remains visible inside the settlement notification, before any save",
      "proof": "test_held_edit_settlement_truth.py"
    },
    {
      "entry": "ProjectViewModel::saveTo from a separate public-header consumer",
      "owner": "an unowned caller cannot borrow a pending operation through the legacy delegate",
      "proof": "test_public_save_boundary.py"
    }
  ]
