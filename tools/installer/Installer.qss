QWizard, QWizardPage, QWidget#SideWidget, QListWidget#PageListWidget,
QWizard > QWidget > QWidget[autoFillBackground="true"] {
    background-color: palette(window);
}

QWizard QPushButton, QWizard QLineEdit, QWizard QComboBox {
    color: palette(window-text);
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 5px;
    min-height: 22px;
    padding: 3px 9px;
}

QWizard QPushButton {
    min-width: 70px;
}

QWizard QPushButton:hover {
    background-color: palette(button);
    border-color: palette(highlight);
}

QWizard QPushButton:focus, QWizard QLineEdit:focus, QWizard QComboBox:focus {
    border-color: palette(highlight);
}

QWizard QPushButton:default {
    background-color: #0079b7;
    color: white;
    border-color: #006a9e;
}

QWizard QPushButton:default:hover, QWizard QPushButton:default:focus {
    background-color: #006a9e;
    border-color: palette(highlight);
}

QWizard QPushButton:pressed {
    background-color: palette(midlight);
    color: palette(window-text);
}

QWizard QPushButton:disabled {
    background-color: palette(window);
    color: palette(mid);
    border-color: palette(midlight);
}

QWizard QLineEdit#SearchLineEdit {
    min-width: 95px;
}

QWizard #ComponentSelectionPage #SpaceItem {
    min-width: 28em;
}

QWizard QLineEdit#TargetDirectoryLineEdit,
QWizard QPushButton#BrowseDirectoryButton {
    min-height: 28px;
    max-height: 28px;
    padding: 0 9px;
}
