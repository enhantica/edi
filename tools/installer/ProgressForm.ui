<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!-- The installing page's content: the logo, one status line, and the progress bar with its percentage inside
     (Installer.qs feeds them from the Framework's own label and bar, which are hidden: the Framework rewrites its
     label on every step). -->
<ui version="4.0">
 <class>ProgressForm</class>
 <widget class="QWidget" name="ProgressForm">
  <!-- Takes the page's spare height, with its content at the top like every other page's. -->
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
    <horstretch>0</horstretch>
    <verstretch>1</verstretch>
   </sizepolicy>
  </property>
  <layout class="QVBoxLayout" name="ProgressColumn">
   <!-- The row gap of every page (Installer.qs). -->
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <!-- The logo in a row of its own, 32 above the rows (Installer.qs, logoStep): the row gap and 24 under it. -->
   <item>
    <layout class="QHBoxLayout" name="ProgressLogoRow">
     <property name="leftMargin">
      <number>0</number>
     </property>
     <property name="topMargin">
      <number>0</number>
     </property>
     <property name="rightMargin">
      <number>0</number>
     </property>
     <property name="bottomMargin">
      <number>24</number>
     </property>
     <item>
      <widget class="QLabel" name="EdiProgressLogo"/>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="EdiProgressStatus"/>
   </item>
   <item>
    <widget class="QProgressBar" name="EdiProgressBar">
     <property name="textVisible">
      <bool>true</bool>
     </property>
     <property name="format">
      <string>%p%</string>
     </property>
     <property name="value">
      <number>0</number>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="ProgressSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
</ui>
