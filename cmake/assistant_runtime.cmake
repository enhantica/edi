# SPDX-License-Identifier: BSD-3-Clause
# ADR-0056: an app-owned official native runtime, never a global installation.
function(edi_bundle_assistant_runtime)
    if(EMSCRIPTEN)
        return()
    endif()
    option(EDI_ASSISTANT_DEDICATED_RUNTIME "Consume a separately qualified Pixi-provisioned Edi-only runtime" OFF)
    set(EDI_CODEX_SOURCE_PATCH_SHA256 "")
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
        set(target aarch64-apple-darwin)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
        set(target x86_64-unknown-linux-musl)
    else()
        message(FATAL_ERROR "No qualified native agent input for ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    set(EDI_CODEX_INPUT_MANIFEST "${PROJECT_SOURCE_DIR}/build/deps/codex/provisioned/${target}/input.json" CACHE FILEPATH "Existing Pixi-provisioned native helper manifest")
    if(NOT EXISTS "${EDI_CODEX_INPUT_MANIFEST}" OR IS_SYMLINK "${EDI_CODEX_INPUT_MANIFEST}")
        message(FATAL_ERROR "Native helper is not provisioned. Run: pixi run -e app assistant-runtime")
    endif()
    file(READ "${EDI_CODEX_INPUT_MANIFEST}" input)
    foreach(key schema root version target archive_sha256 dedicated files)
        string(JSON input_${key} ERROR_VARIABLE parse_error GET "${input}" "${key}")
        if(parse_error)
            message(FATAL_ERROR "Invalid provisioned agent manifest field ${key}")
        endif()
    endforeach()
    if(NOT input_schema STREQUAL "edi.assistant.provisioned/1" OR NOT input_target STREQUAL target OR
       NOT IS_ABSOLUTE "${input_root}" OR NOT IS_DIRECTORY "${input_root}" OR IS_SYMLINK "${input_root}")
        message(FATAL_ERROR "The provisioned native agent input identity is incompatible")
    endif()
    if((EDI_ASSISTANT_DEDICATED_RUNTIME AND NOT input_dedicated) OR (NOT EDI_ASSISTANT_DEDICATED_RUNTIME AND input_dedicated))
        message(FATAL_ERROR "Provisioned agent flavour differs; run the appropriate Pixi provision task")
    endif()
    set(version "${input_version}")
    set(digest "${input_archive_sha256}")
    string(LENGTH "${digest}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid provisioned archive digest")
    endif()
    get_filename_component(cache "${input_root}" DIRECTORY)
    file(LOCK "${cache}/stage.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE locked)
    if(NOT locked STREQUAL "0")
        message(FATAL_ERROR "Another native agent staging owner is active: ${locked}")
    endif()
    string(JSON member_count LENGTH "${input}" files)
    set(input_members)
    if(member_count LESS 1)
        message(FATAL_ERROR "The provisioned helper has no verified files")
    endif()
    math(EXPR last_member "${member_count}-1")
    foreach(index RANGE 0 ${last_member})
        string(JSON member MEMBER "${input}" files ${index})
        if(IS_ABSOLUTE "${member}" OR member MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Escaping provisioned helper member")
        endif()
        list(APPEND input_members "${member}")
        string(JSON expected GET "${input}" files "${member}")
        if(NOT EXISTS "${input_root}/${member}" OR IS_DIRECTORY "${input_root}/${member}" OR IS_SYMLINK "${input_root}/${member}")
            message(FATAL_ERROR "Missing regular provisioned helper member ${member}")
        endif()
        file(SHA256 "${input_root}/${member}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Corrupt provisioned helper member ${member}")
        endif()
    endforeach()
    file(GLOB_RECURSE actual_members LIST_DIRECTORIES false RELATIVE "${input_root}" "${input_root}/*")
    list(SORT actual_members)
    list(SORT input_members)
    if(NOT actual_members STREQUAL input_members)
        message(FATAL_ERROR "The provisioned native helper membership changed")
    endif()
    set(stage "${cache}/stage")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(COPY "${input_root}/" DESTINATION "${stage}" USE_SOURCE_PERMISSIONS)
    file(READ "${stage}/codex-package.json" metadata)
    foreach(pair "layoutVersion|1" "version|${version}" "target|${target}" "variant|codex-app-server" "entrypoint|bin/codex-app-server" "resourcesDir|codex-resources" "pathDir|codex-path")
        string(REPLACE "|" ";" values "${pair}")
        list(GET values 0 key)
        list(GET values 1 expected)
        string(JSON value ERROR_VARIABLE parse_error GET "${metadata}" "${key}")
        if(parse_error OR NOT value STREQUAL expected)
            message(FATAL_ERROR "Provisioned agent package has incompatible ${key}")
        endif()
    endforeach()
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        file(SHA256 "${PROJECT_SOURCE_DIR}/tools/assistant-runtime/edi-app-server.patch" EDI_CODEX_SOURCE_PATCH_SHA256)
    endif()
    set(EDI_CODEX_RUNTIME_VERSION "${version}")
    if(EDI_ASSISTANT_DEDICATED_RUNTIME)
        foreach(pair "ediPolicySchema|edi.runtime-policy/1" "ediFlavour|edi-app-server/1" "upstreamCommit|092d3acd6bec3e3a14bdc7e7a2810ab628ab759d" "sourcePatchSha256|${EDI_CODEX_SOURCE_PATCH_SHA256}")
            string(REPLACE "|" ";" values "${pair}")
            list(GET values 0 key)
            list(GET values 1 expected)
            string(JSON value ERROR_VARIABLE parse_error GET "${metadata}" "${key}")
            if(parse_error OR NOT value STREQUAL expected)
                message(FATAL_ERROR "Dedicated Edi runtime has incompatible ${key}")
            endif()
        endforeach()
    endif()
    set(required bin/codex-app-server bin/codex-code-mode-host codex-path/rg codex-resources/zsh/bin/zsh)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND required codex-resources/bwrap)
    endif()
    foreach(member IN LISTS required)
        if(NOT EXISTS "${stage}/${member}" OR IS_DIRECTORY "${stage}/${member}" OR IS_SYMLINK "${stage}/${member}")
            message(FATAL_ERROR "Official agent package is missing its regular executable ${member}")
        endif()
        execute_process(COMMAND test -x "${stage}/${member}" RESULT_VARIABLE executable)
        if(NOT executable EQUAL 0)
            message(FATAL_ERROR "Official agent package executable has wrong permissions: ${member}")
        endif()
    endforeach()
    # Preserve signed executable bytes/modes and relative resource closure.
    file(COPY "${PROJECT_SOURCE_DIR}/data/assistant/runtime/" DESTINATION "${stage}/edi-licenses")
    # Publication is content-addressed and immutable. Existing app/build/install
    # readers retain their complete tree throughout another graph's configure.
    file(GLOB_RECURSE members LIST_DIRECTORIES false RELATIVE "${stage}" "${stage}/*")
    set(publication "official-runtime-layout-1;${target};${digest}")
    foreach(member IN LISTS members)
        if(IS_SYMLINK "${stage}/${member}")
            message(FATAL_ERROR "Bundled runtime member is a link: ${member}")
        endif()
        execute_process(COMMAND test -f "${stage}/${member}" RESULT_VARIABLE regular)
        if(NOT regular EQUAL 0)
            message(FATAL_ERROR "Bundled runtime member is not a regular file: ${member}")
        endif()
        file(SHA256 "${stage}/${member}" hash)
        string(APPEND publication ";${member}:${hash}")
        set(member_hash_${member} "${hash}")
    endforeach()
    string(SHA256 publication "${publication}")
    set(EDI_CODEX_RUNTIME_BUILD_DIR "${cache}/runtime-${publication}")
    set(EDI_CODEX_RUNTIME_TARGET "${target}")
    set(EDI_CODEX_BUILD_APP_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(EDI_CODEX_INSTALL_RELATIVE "../${CMAKE_INSTALL_LIBEXECDIR}/edi/codex")
    set(check "${CMAKE_CURRENT_BINARY_DIR}/verify_assistant_runtime_${publication}.cmake")
    set(check_contents "# Generated from the digest-verified official archive and owned legal resources.\n")
    foreach(member IN LISTS members)
        set(path "${EDI_CODEX_RUNTIME_BUILD_DIR}/${member}")
        string(APPEND check_contents "if(IS_SYMLINK [==[${path}]==])\n message(FATAL_ERROR [==[Linked bundled runtime member ${member}]==])\nendif()\nexecute_process(COMMAND test -f [==[${path}]==] RESULT_VARIABLE regular)\nif(NOT regular EQUAL 0)\n message(FATAL_ERROR [==[Missing regular bundled runtime member ${member}]==])\nendif()\n")
        if(member IN_LIST required)
            string(APPEND check_contents "execute_process(COMMAND test -x [==[${path}]==] RESULT_VARIABLE executable)\nif(NOT executable EQUAL 0)\n message(FATAL_ERROR [==[Nonexecutable bundled runtime member ${member}]==])\nendif()\n")
        endif()
        string(APPEND check_contents "file(SHA256 [==[${path}]==] actual)\nif(NOT actual STREQUAL [==[${member_hash_${member}}]==])\n message(FATAL_ERROR [==[Corrupt bundled runtime member ${member}]==])\nendif()\n")
    endforeach()
    # The verifier is immutable too: a concurrent old build may be reading it.
    if(EXISTS "${check}" OR IS_SYMLINK "${check}")
        if(IS_DIRECTORY "${check}" OR IS_SYMLINK "${check}")
            message(FATAL_ERROR "Bundled runtime verifier is not a regular owned file")
        endif()
        file(READ "${check}" existing_check)
        if(NOT existing_check STREQUAL check_contents)
            message(FATAL_ERROR "Bundled runtime verifier identity changed")
        endif()
    else()
        file(WRITE "${check}.stage" "${check_contents}")
        file(RENAME "${check}.stage" "${check}")
    endif()
    if(EXISTS "${EDI_CODEX_RUNTIME_BUILD_DIR}" OR IS_SYMLINK "${EDI_CODEX_RUNTIME_BUILD_DIR}")
        # Never replace a published identity, even if it was externally damaged.
        # Fail closed; callers of a previous valid identity remain unaffected.
        if(IS_SYMLINK "${EDI_CODEX_RUNTIME_BUILD_DIR}")
            message(FATAL_ERROR "Bundled runtime publication must not be a link")
        endif()
        include("${check}")
        file(REMOVE_RECURSE "${stage}")
    else()
        # The same-target acquisition lock prevents a second publisher. Rename
        # only a complete verified candidate into a previously absent identity.
        file(RENAME "${stage}" "${EDI_CODEX_RUNTIME_BUILD_DIR}")
        include("${check}")
    endif()
    configure_file("${PROJECT_SOURCE_DIR}/cmake/assistant_runtime_config.hpp.in" "${CMAKE_CURRENT_BINARY_DIR}/assistant_runtime_config.hpp" @ONLY)
    add_custom_target(edi_assistant_runtime_check COMMAND "${CMAKE_COMMAND}" -P "${check}")
    add_dependencies(edi_app_module edi_assistant_runtime_check)
    install(SCRIPT "${check}")
    install(DIRECTORY "${EDI_CODEX_RUNTIME_BUILD_DIR}/" DESTINATION "${CMAKE_INSTALL_LIBEXECDIR}/edi/codex" USE_SOURCE_PERMISSIONS)
endfunction()
