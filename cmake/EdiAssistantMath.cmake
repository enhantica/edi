# ADR-0056: the canonical Pixi task provisions original source; this adapter builds only its native math subtargets.
if(EMSCRIPTEN)
    return()
endif()
set(_edi_math_manifest "${PROJECT_SOURCE_DIR}/build/deps/assistant-math.json")
if(NOT EXISTS "${_edi_math_manifest}")
    message(FATAL_ERROR "Native math source is absent. Run pixi run -e app assistant-math first.")
endif()
file(READ "${_edi_math_manifest}" _edi_math)
string(JSON _edi_math_schema GET "${_edi_math}" schema)
string(JSON _edi_math_commit GET "${_edi_math}" commit)
string(JSON _edi_math_manifest_hash GET "${_edi_math}" manifest_sha256)
file(SHA256 "${PROJECT_SOURCE_DIR}/pixi.toml" _edi_math_current_manifest_hash)
if(NOT _edi_math_schema STREQUAL "edi.assistant.math-source/1" OR NOT _edi_math_manifest_hash STREQUAL _edi_math_current_manifest_hash)
    message(FATAL_ERROR "Native math provisioning is stale. Run the canonical Pixi assistant-math task.")
endif()
string(JSON EDI_ASSISTANT_MATH_SOURCE GET "${_edi_math}" source)
file(REAL_PATH "${PROJECT_SOURCE_DIR}/build/deps/jkqtmathtext/${_edi_math_commit}/source" _edi_math_expected_source)
if(NOT EDI_ASSISTANT_MATH_SOURCE STREQUAL _edi_math_expected_source OR IS_SYMLINK "${EDI_ASSISTANT_MATH_SOURCE}")
    message(FATAL_ERROR "Native math source identity changed.")
endif()
string(JSON _edi_math_count LENGTH "${_edi_math}" files)
file(GLOB_RECURSE _edi_math_files LIST_DIRECTORIES false RELATIVE "${EDI_ASSISTANT_MATH_SOURCE}" "${EDI_ASSISTANT_MATH_SOURCE}/*")
list(LENGTH _edi_math_files _edi_math_actual_count)
if(NOT _edi_math_count EQUAL _edi_math_actual_count)
    message(FATAL_ERROR "Native math source closure changed.")
endif()
foreach(_file IN LISTS _edi_math_files)
    string(JSON _expected GET "${_edi_math}" files "${_file}")
    file(SHA256 "${EDI_ASSISTANT_MATH_SOURCE}/${_file}" _actual)
    if(IS_SYMLINK "${EDI_ASSISTANT_MATH_SOURCE}/${_file}" OR NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Native math source changed: ${_file}")
    endif()
endforeach()
find_package(Qt6 REQUIRED COMPONENTS Widgets Xml)
function(edi_assistant_math_targets)
    set(PROJECT_VERSION 5.0.0)
    set(PROJECT_VERSION_MAJOR 5)
    set(QT_VERSION_MAJOR 6)
    set(BUILD_SHARED_LIBS OFF)
    set(CMAKE_AUTOMOC ON)
    set(jkqtplotter_LIBNAME_VERSION_PART Edi)
    set(jkqtplotter_namespace EdiMath::)
    set(JKQtPlotter_ENABLED_CXX20 ON)
    set(JKQtPlotter_QT_CXX_STANDARD 20)
    set(JKQtPlotter_QT_CXX_STANDARD_REQUIRED ON)
    set(JKQtPlotter_QT_CXX_COMPILE_FEATURE cxx_std_20)
    set(JKQtPlotter_BUILD_WITH_PRECOMPILED_HEADERS OFF)
    set(JKQtPlotter_ENABLED_STD_FORMAT OFF)
    set(JKQtPlotter_BUILD_INCLUDE_XITS_FONTS ON)
    set(JKQtPlotter_BUILD_INCLUDE_FIRAMATH_FONTS OFF)
    include("${EDI_ASSISTANT_MATH_SOURCE}/cmake/jkqtplotter_macros.cmake")
    # Edi ships the linked app and original notices, not an unrelated development SDK/header installation.
    function(jkqtplotter_installlibrary_new)
    endfunction()
    add_subdirectory("${EDI_ASSISTANT_MATH_SOURCE}/lib/jkqtcommon" "${CMAKE_CURRENT_BINARY_DIR}/assistant-math/common")
    add_subdirectory("${EDI_ASSISTANT_MATH_SOURCE}/lib/jkqtmathtext" "${CMAKE_CURRENT_BINARY_DIR}/assistant-math/mathtext")
endfunction()
edi_assistant_math_targets()
